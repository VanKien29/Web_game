{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "clean:build": "node -e \"require('fs').rmSync('public/build',{recursive:true,force:true})\"",
        "build": "npm run clean:build && vite build",
        "dev": "vite --force",
        "web": "concurrently -n laravel,vite -c blue,green \"php artisan serve --host=127.0.0.1 --port=8000\" \"vite --force --host 127.0.0.1 --port 5173\""
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "axios": ">=1.11.0 <=1.14.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^3.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "^7.2.0",
        "@vitejs/plugin-vue": "^6.0.5",
        "vue": "^3.5.31",
        "vue-router": "^4.6.4"
    }
}
