[Unit]
Description=NRO WebGL WebSocket gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/nro-laravel/deploy/webgl-gateway
Environment=NODE_ENV=production
Environment=LISTEN_HOST=127.0.0.1
Environment=LISTEN_PORT=8080
Environment=TARGET_HOST=127.0.0.1
Environment=TARGET_PORTS=14445
Environment=WEBGL_BUILD_DIR=/var/www/nro-laravel/public/play
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
